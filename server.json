{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.autumn-dev/autumn-bus",
  "description": "Durable agent messages, shared tasks, channels and files in a local workspace.",
  "repository": {
    "url": "https://github.com/Adi103-ETAI/autumn-bus",
    "source": "github"
  },
  "version": "0.1.0-next.15",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@autumn-dev/autumn-bus",
      "version": "0.1.0-next.15",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "stdio"
        },
        {
          "type": "named",
          "name": "--scope",
          "value": "{workspace}",
          "variables": {
            "workspace": {
              "description": "Existing local workspace; start the daemon and create this workspace before connecting.",
              "default": "default",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "--new-session"
        }
      ]
    }
  ]
}
