{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Adi103-ETAI/autumn-bus/spec/0.1/schemas/compatibility-registry.schema.json",
  "title": "Autumn Bus compatibility registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verified"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verified": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence/[a-z0-9][a-z0-9._/-]*\\.json$"
      }
    }
  }
}
