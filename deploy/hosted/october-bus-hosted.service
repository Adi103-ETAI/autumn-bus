[Unit]
Description=Autumn Bus hosted workspaces
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autumn-bus-hosted
Group=autumn-bus-hosted
EnvironmentFile=/etc/autumn-bus/hosted.env
Environment=AUTUMN_BUS_ATTACHMENTS_DIR=/var/lib/autumn-bus-hosted/attachments
Environment=GOMEMLIMIT=512MiB
Environment=GOMAXPROCS=2
StateDirectory=autumn-bus-hosted
StateDirectoryMode=0700
ExecStart=/opt/autumn-bus-hosted/current/autumn-bus hosted serve --public-url ${AUTUMN_BUS_PUBLIC_URL}
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryHigh=640M
MemoryMax=768M
TasksMax=256
LimitNOFILE=8192
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
