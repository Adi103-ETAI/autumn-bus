[Unit]
Description=Encrypted Autumn Bus database and file backup
After=network-online.target autumn-bus-hosted.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/autumn-bus/backup.env
Environment=AUTUMN_BUS_ATTACHMENTS_DIR=/var/lib/autumn-bus-hosted/attachments
Environment=AUTUMN_BUS_SERVICE_ENV=/etc/autumn-bus/hosted.env
Environment=AUTUMN_BUS_BINARY=/opt/autumn-bus-hosted/current/autumn-bus
Environment=AUTUMN_BUS_BACKUP_CACHE=/var/cache/autumn-bus-backup
Environment=AUTUMN_BUS_BACKUP_STATE=/var/lib/autumn-bus-backup
Environment=RESTIC_CACHE_DIR=/var/cache/autumn-bus-backup/restic
Environment=GOMAXPROCS=2
CacheDirectory=autumn-bus-backup
CacheDirectoryMode=0700
StateDirectory=autumn-bus-backup
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/autumn-bus-hosted/current/backup.py
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autumn-bus-hosted/attachments

