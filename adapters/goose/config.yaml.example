{
  "extensions": {
    "agent_intercom": {
      "name": "Autumn Bus",
      "type": "stdio",
      "cmd": "{{command}}",
      "args": [
        "mcp",
        "stdio",
        "--scope",
        "{{scope}}",
        "--agent",
        "{{agent}}",
        "--name",
        "{{name}}",
        "--data-dir",
        "{{dataDir}}",
        "--runtime-dir",
        "{{runtimeDir}}"
      ],
      "enabled": true,
      "timeout": 60
    }
  }
}
